# 统一换行符，避免跨平台 diff 噪音
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell 脚本必须是 LF —— 带 CRLF 的 .sh 在 Linux 上会报
# "bad interpreter: /usr/bin/env bash^M" 直接跑不起来
*.sh text eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.webm binary
*.sqlite3 binary
*.woff binary
*.woff2 binary
